{
  "name": "conference-hall",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#nonce": "./app/shared/nonce/nonce.server.ts"
  },
  "scripts": {
    "dev": "pnpm --reporter=append-only run /^dev:/",
    "dev:web": "NODE_OPTIONS='--conditions=development --import ./servers/otel.web.ts' react-router dev",
    "dev:job": "tsx watch --import ./servers/otel.jobs.ts ./servers/jobs.ts",
    "start": "node --import ./servers/otel.web.ts ./servers/web.ts",
    "build": "prisma generate && react-router build",
    "jobs:start": "tsx --import ./servers/otel.jobs.ts ./servers/jobs.ts",
    "jobs:build": "prisma generate",
    "test": "pnpm test:db && pnpm test:unit",
    "test:db": "NODE_ENV=test prisma db push --accept-data-loss",
    "test:unit": "vitest --browser.headless",
    "test:browser": "vitest --project browser",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:e2e:ui": "NODE_ENV=test playwright test --ui --ui-host=localhost",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset -f && prisma generate && prisma db seed",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "tsc": "react-router typegen && tsc -b",
    "knip": "knip"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@conform-to/zod": "^1.21.2",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/abstract": "^0.5.1",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@fastify/compress": "^9.3.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@floating-ui/react": "^0.27.20",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@mcansh/react-router-fastify": "^6.0.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/instrumentation": "^7.10.1",
    "@react-router/node": "~8.5.1",
    "@remix-run/form-data-parser": "^1.1.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@tanstack/react-hotkeys": "^0.17.0",
    "better-auth": "~1.7.14",
    "bullmq": "^6.5.0",
    "bullmq-otel": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.7",
    "firebase-scrypt": "^2.2.0",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-fetch-backend": "^8.0.0",
    "isbot": "^5.2.2",
    "json-2-csv": "^5.6.0",
    "mailgun.js": "^14.1.0",
    "marked": "^18.1.2",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.4",
    "react-i18next": "^17.1.9",
    "react-router": "~8.5.1",
    "recharts": "^3.10.1",
    "redis": "^6.3.0",
    "remix-i18next": "^8.0.0",
    "sitemap": "^10.0.0",
    "sonner": "^2.0.8",
    "use-debounce": "^10.1.1",
    "xss": "^1.0.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@ngneat/falso": "^8.0.2",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "~8.5.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "~1.90.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "packageManager": "pnpm@12.16.1"
}
